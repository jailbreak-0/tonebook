{
  "expo": {
    "name": "ToneBook",
    "slug": "tonebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tonebook-icon-appStore.png",
    "scheme": "tonebook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/tonebook-icon-appStore.png"
    },
    "android": {
      "icon": "./assets/images/tonebook-icon-playStore.png",
      "package": "com.nyamek.tonebook",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "notification": {
        "icon": "./assets/images/tonebook-notif-icon.png",
        "color": "#ff9f1c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d93424ed-c65a-43cc-85b0-2a0ce6f4fd35"
      }
    }
  }
}
